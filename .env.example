# Database Configuration
POSTGRES_DB=bookmanager_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_postgres_password
POSTGRES_PORT=5432

# Application Configuration
API_PORT=8080
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://+:8080

# JWT Authentication Configuration
JWT_SECRET=your_super_secret_access_key_min_32_characters_long
JWT_REFRESH_SECRET=your_super_secret_refresh_key_min_32_characters_long
JWT_ISSUER=BookManagerAPI
JWT_AUDIENCE=BookManagerClient
JWT_EXPIRES_MINUTES=15
JWT_REFRESH_EXPIRES_DAYS=7
